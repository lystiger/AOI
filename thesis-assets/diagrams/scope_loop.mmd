%% Scope of the AOI monitoring loop — replaces ASCII fig:scope_loop (thesis section 1.3)
%% Top row = implemented in this thesis; bottom row = future work (out of scope).
%% Render: see diagrams/README.md (paste into mermaid.live, export SVG/PDF).
%%{init: {"theme":"base","themeVariables":{"fontFamily":"Helvetica, Arial, sans-serif","primaryColor":"#DBE9FF","primaryBorderColor":"#3B6FB0","primaryTextColor":"#0B2545","lineColor":"#5A6B7B","textColor":"#15202B","clusterBorder":"#9AA0A6"}}}%%
flowchart TB
  subgraph IMPL["Implemented in this thesis"]
    direction LR
    OP["Production operator /<br/>AI-assisted AOI"] --> SVC["AOI inference service<br/>(structured events)"]
    SVC --> MON["Monitoring<br/>Loki · Promtail · Grafana"]
    MON --> EV["Queryable evidence<br/>JSONL · LogQL · alerts"]
  end

  subgraph FUT["Future work (out of scope)"]
    direction LR
    RCA["Automated<br/>root-cause analysis"] --> REC["Process<br/>recommendation"]
    REC --> RT["Model<br/>retraining"]
  end

  EV -. "scope boundary" .-> RCA
  RT -. "closes the loop" .-> SVC

  classDef impl   fill:#DBE9FF,stroke:#3B6FB0,color:#0B2545;
  classDef future fill:#F0F0F0,stroke:#9AA0A6,color:#5F6368,stroke-dasharray:4 3;
  class OP,SVC,MON,EV impl;
  class RCA,REC,RT future;

  style IMPL fill:#EEF5FF,stroke:#3B6FB0,color:#0B2545;
  style FUT  fill:#F4F4F4,stroke:#9AA0A6,color:#5F6368,stroke-dasharray:5 4;
